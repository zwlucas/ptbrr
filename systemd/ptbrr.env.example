# ==============================================================================
# ptbrr Environment Configuration
# Location on Linux/LXC: /etc/ptbrr/ptbrr.env
# Permissions: chmod 600 /etc/ptbrr/ptbrr.env
# ==============================================================================

# Port on which ptbrr listens (default: 9697)
PORT=9697

# Network interface address to bind to (0.0.0.0 allows LAN/Proxmox container access)
HOST=0.0.0.0

# Base URL of your actual Prowlarr instance
# Example: http://192.168.1.100:9696 or http://localhost:9696
PROWLARR_URL=http://localhost:9696

# The Movie Database (TMDB) API Key (v3 auth)
# Get a free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Cache duration for translated titles in minutes (1440 = 24 hours)
CACHE_TTL_MINUTES=1440

# Network timeout for outbound requests in seconds
REQUEST_TIMEOUT_SECONDS=15
